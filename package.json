{
  "name": "procureai-invoice-processor",
  "private": true,
  "version": "0.1.0",
  "description": "ProcureAI Invoice Processor",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev:api": "pnpm --filter @procureai/api dev",
    "dev:worker": "pnpm --filter @procureai/worker dev",
    "dev": "concurrently \"pnpm dev:api\" \"pnpm dev:worker\"",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint . --ext .ts",
    "test": "jest --config jest.config.cjs",
    "test:watch": "jest --config jest.config.cjs --watch"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.147",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.30",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.34.1",
    "@typescript-eslint/parser": "^8.34.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.30.1",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^29.7.0",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "uuid": "^9.0.1"
  }
}
